# Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/pesonakebaikan?schema=public"

# Auth Configuration (NextAuth.js)
# Generate a secret with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MIN_DONATION=10000

# Email Configuration (SMTP)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_SERVER_SECURE=true
EMAIL_FROM="Pesona Kebaikan <no-reply@pesonakebaikan.com>"

# Payment Gateway Provider: midtrans | doku
PAYMENT_PROVIDER=midtrans
NEXT_PUBLIC_PAYMENT_PROVIDER=midtrans

# Midtrans Configuration
# Switch to true for production environment
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Midtrans Keys (Get these from Midtrans Dashboard)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IRIS_API_KEY=

# Feature Flags (Midtrans Payouts)
MIDTRANS_PAYOUTS_ENABLED=false

# DOKU Configuration (only needed when PAYMENT_PROVIDER=doku)
# Get credentials from DOKU Dashboard: https://dashboard.doku.com
DOKU_IS_PRODUCTION=false
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=

# S3 Storage Configuration (Object Storage)
# Compatible with AWS S3, Cloudflare R2, MinIO, etc.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ROOT_DIR=uploads

# Development Bypass Flags (Set to false in production)
NEXT_PUBLIC_BYPASS_OTP=false
NEXT_PUBLIC_DISBURSEMENT_BYPASS_OTP=false
NEXT_PUBLIC_DISBURSEMENT_BYPASS_STATUS_UPDATE=false
