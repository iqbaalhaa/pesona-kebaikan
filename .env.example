# Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/pesonakebaikan?schema=public"

# Auth Configuration (NextAuth.js)
# Generate a secret with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MIN_DONATION=10000

# Email Configuration (SMTP)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_SERVER_SECURE=true
EMAIL_FROM="Pesona Kebaikan <no-reply@pesonakebaikan.com>"

# Payment Gateway Provider: doku
PAYMENT_PROVIDER=doku
NEXT_PUBLIC_PAYMENT_PROVIDER=doku

# DOKU Checkout Configuration (accepting donations)
# Get credentials from DOKU Dashboard: https://dashboard.doku.com
DOKU_IS_PRODUCTION=false
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Comma-separated list of DOKU payment method types to show (empty = show all)
DOKU_PAYMENT_METHODS=VIRTUAL_ACCOUNT_BRI,VIRTUAL_ACCOUNT_BNI,VIRTUAL_ACCOUNT_BANK_PERMATA,VIRTUAL_ACCOUNT_DOKU,VIRTUAL_ACCOUNT_BANK_CIMB,QRIS

# S3 Storage Configuration (Object Storage)
# Compatible with AWS S3, Cloudflare R2, MinIO, etc.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ROOT_DIR=uploads

# Development Bypass Flags (Set to false in production)
NEXT_PUBLIC_BYPASS_OTP=false

# Cron Jobs (see src/app/api/cron/*)
# Bearer token the /api/cron/* routes require — generate with
# `openssl rand -base64 32`. Triggered by a VPS crontab entry calling curl
# with this as the Authorization header (see CLAUDE.md's Cron Jobs section).
CRON_SECRET=
