# Local Development Configuration
# Copy this file to .env.local and fill in your local secrets

# Database
DATABASE_URL="postgresql://postgres:root@localhost:5432/pesonakebaikan?schema=public"

# Auth
# You can generate one via `npx auth secret`
AUTH_SECRET="development-secret-key-change-me"
AUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MIN_DONATION=1

# Email (Optional for local dev, required for auth emails)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_SERVER_SECURE=true
EMAIL_FROM="Pesona Kebaikan <dev@localhost>"

# Payment provider
PAYMENT_PROVIDER=doku
NEXT_PUBLIC_PAYMENT_PROVIDER=doku

# DOKU Checkout (Sandbox Keys)
DOKU_IS_PRODUCTION=false
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=

# DOKU Payout (Kirim DOKU) — separate credentials from checkout above
DOKU_PAYOUTS_ENABLED=false
DOKU_PAYOUT_PARTNER_ID=
DOKU_PAYOUT_CLIENT_SECRET=
DOKU_PAYOUT_PRIVATE_KEY=
DOKU_PAYOUT_CHANNEL_ID=
DOKU_PAYOUT_ACCOUNT_NO=

# S3 Storage
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ROOT_DIR=dev-uploads

# Dev Flags
NEXT_PUBLIC_BYPASS_OTP=true
NEXT_PUBLIC_DISBURSEMENT_BYPASS_OTP=true
NEXT_PUBLIC_DISBURSEMENT_BYPASS_STATUS_UPDATE=true
